---
import company from '../data/company.json';
import { getUrl } from '../utils/paths';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="border-t border-zinc-200 dark:border-white/[0.06] bg-white dark:bg-[#0d0e11] pt-16 pb-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- 4-колоночный информационный блок -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <!-- Колонка 1: Компания -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-3 h-3 rounded-full bg-[#3dd68c]"></div>
          <span class="text-lg font-extrabold tracking-tight text-zinc-900 dark:text-white">{company.brand}</span>
        </div>
        <p class="text-xs text-zinc-500 leading-relaxed">
          {company.name}. Поставки строительных, гидро- и теплоизоляционных материалов со склада в г. Омске. Оптовая и розничная продажа с {company.foundingYear} года.
        </p>
        <div class="pt-2">
          <span class="text-[11px] font-mono font-bold text-[#0d9488] dark:text-[#3dd68c] block">
            Офис и склад на одной территории
          </span>
        </div>
      </div>

      <!-- Колонка 2: Навигация и прайс -->
      <div class="space-y-3 font-mono text-xs">
        <span class="font-bold uppercase tracking-widest text-zinc-900 dark:text-white block">Разделы:</span>
        <div class="space-y-2 text-zinc-500 dark:text-zinc-400">
          <div><button type="button" onclick="downloadFullCatalogPdf()" class="hover:text-[#3dd68c] transition text-left underline decoration-dotted">Скачать прайс (PDF)</button></div>
          <div><a href={`${base}/catalog`} class="hover:text-zinc-900 dark:hover:text-white transition">Каталог номенклатуры</a></div>
          <div><a href={`${base}/collections`} class="hover:text-zinc-900 dark:hover:text-white transition">Отраслевые подборки</a></div>
          <div><a href={`${base}/articles`} class="hover:text-zinc-900 dark:hover:text-white transition">Статьи и база знаний</a></div>
          <div><a href={`${base}/contacts`} class="hover:text-zinc-900 dark:hover:text-white transition">Контакты и склад</a></div>
        </div>
      </div>

      <!-- Колонка 3: Склад и режим работы -->
      <div class="space-y-3 font-mono text-xs">
        <span class="font-bold uppercase tracking-widest text-zinc-900 dark:text-white block">Склад-магазин:</span>
        <div class="space-y-1.5 text-zinc-500 dark:text-zinc-400">
          <button data-copy={company.warehouseAddress} class="text-left hover:text-zinc-900 dark:hover:text-white transition block">
            {company.warehouseAddress}
          </button>
          <div class="pt-2 text-zinc-800 dark:text-zinc-300 font-semibold">{company.workSchedule.weekdays}</div>
          <div>{company.workSchedule.saturday}</div>
          <div class="text-rose-500/80">{company.workSchedule.sunday}</div>
        </div>
      </div>

      <!-- Колонка 4: Способы оплаты и реквизиты -->
      <div class="space-y-3 font-mono text-xs">
        <span class="font-bold uppercase tracking-widest text-zinc-900 dark:text-white block">Оплата и связь:</span>
        <div class="space-y-1 text-zinc-500 dark:text-zinc-400">
          <div>• Безналичный расчет с НДС</div>
          <div>• Оплата по QR-коду</div>
          <div>• Наличный расчет</div>
        </div>
        <div class="pt-2 space-y-1">
          <button data-copy={company.mainPhone} class="text-zinc-900 dark:text-white font-bold block hover:underline">
            Тел: {company.mainPhone} (Макс)
          </button>
          <button data-copy={company.emailSales} class="text-zinc-500 hover:text-zinc-900 dark:hover:text-white block hover:underline">
            {company.emailSales}
          </button>
        </div>
      </div>

    </div>

    <!-- Нижняя полоса копирайта и реквизитов -->
    <div class="pt-8 border-t border-zinc-200 dark:border-white/[0.06] flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-mono text-zinc-400">
      <div class="flex flex-wrap gap-4">
        <button data-copy={company.requisites.inn} class="hover:text-zinc-900 dark:hover:text-white transition">
          ИНН: {company.requisites.inn}
        </button>
        <button data-copy={company.requisites.ogrn} class="hover:text-zinc-900 dark:hover:text-white transition">
          ОГРН: {company.requisites.ogrn}
        </button>
        <button data-copy={company.requisites.bankName} class="hover:text-zinc-900 dark:hover:text-white transition">
          Банк: {company.requisites.bankName}
        </button>
      </div>

      <div>
        © {new Date().getFullYear()} {company.name}. Все права защищены.
      </div>
    </div>

  </div>
</footer>