---
import company from '../data/company.json';

const formatPhone = (phone: string) => phone.replace(/[^\d+]/g, '');
const managerPhone = company.managerPhone || company.mainPhone;

// Автоматически получает префикс ('/bironiks' на GitHub или '' локально)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="fixed top-6 inset-x-0 z-50 max-w-7xl mx-auto px-4 sm:px-6">
  <nav class="flex items-center justify-between gap-4 px-6 py-3.5 rounded-2xl bg-white/85 dark:bg-[#181a1f]/85 border border-zinc-200/80 dark:border-white/[0.08] backdrop-blur-xl shadow-lg shadow-black/[0.03] dark:shadow-black/20 transition-all duration-300">
    
    <!-- Логотип + Главная -->
    <a href={`${base}/`} class="flex items-center gap-3.5 group shrink-0">
      <div class="relative w-8 h-8 rounded-xl overflow-hidden bg-zinc-100 dark:bg-white/[0.06] border border-zinc-200 dark:border-white/[0.1] flex items-center justify-center p-1.5 transition-transform duration-300 group-hover:scale-105">
        <img 
          src={`${base}/image/logo.svg`} 
          alt={company.brand} 
          class="w-full h-full object-contain"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" 
        />
        <span class="hidden text-xs font-black font-mono tracking-tighter text-[#0d9488] dark:text-[#3dd68c]">
          БХ
        </span>
      </div>

      <div class="flex flex-col">
        <span class="text-base font-extrabold tracking-tight text-zinc-900 dark:text-[#f0f2f5] group-hover:text-[#0d9488] dark:group-hover:text-[#3dd68c] transition-colors leading-none">
          {company.brand}
        </span>
        <span class="text-[10px] font-mono text-zinc-400 mt-1 leading-none hidden sm:inline-block">
          Склад и офис в Омске
        </span>
      </div>
    </a>

    <!-- Строка поиска в Header -->
    <form action={`${base}/catalog`} method="GET" class="relative hidden lg:flex items-center flex-1 max-w-xs">
      <svg class="absolute left-3.5 w-4 h-4 text-zinc-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input 
        type="text" 
        name="search" 
        placeholder="Поиск по номенклатуре..." 
        class="w-full pl-10 pr-4 py-2 rounded-xl bg-zinc-100 dark:bg-white/[0.05] border border-transparent focus:border-[#3dd68c] text-xs font-mono text-zinc-900 dark:text-[#f0f2f5] placeholder-zinc-400 focus:outline-none transition"
      />
    </form>

    <!-- Навигация с корректным base URL -->
    <div class="hidden md:flex items-center gap-6 text-xs font-mono font-medium text-zinc-600 dark:text-zinc-400 shrink-0">
      <a href={`${base}/catalog`} class="hover:text-zinc-900 dark:hover:text-white transition-colors">Каталог</a>
      <a href={`${base}/collections`} class="hover:text-zinc-900 dark:hover:text-white transition-colors">Подборки</a>
      <a href={`${base}/articles`} class="hover:text-zinc-900 dark:hover:text-white transition-colors">Статьи</a>
      <a href={`${base}/contacts`} class="hover:text-zinc-900 dark:hover:text-white transition-colors">Контакты</a>
    </div>

    <!-- Переключатель темы и кнопка Макс -->
    <div class="flex items-center gap-3 shrink-0">
      <button id="theme-toggle" type="button" aria-label="Сменить тему" class="p-2 rounded-xl text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-white/[0.06] transition-colors">
        <svg class="hidden dark:block w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="block dark:hidden w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <a 
        href={`tel:${formatPhone(managerPhone)}`}
        data-copy={managerPhone}
        title="Связаться с менеджером: Макс" 
        class="px-3.5 py-2 rounded-xl bg-[#3dd68c]/15 text-[#0b633b] dark:text-[#3dd68c] hover:bg-[#3dd68c] hover:text-[#111215] text-xs font-mono font-bold border border-[#3dd68c]/30 transition-all duration-300 shadow-sm flex items-center gap-2"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-[#3dd68c] animate-pulse"></span>
        <span>Макс</span>
      </a>
    </div>
  </nav>
</header>