---
import company from '../data/company.json';
import { getUrl } from '../utils/paths';

const formatPhone = (phone: string) => phone.replace(/[^\d+]/g, '');
const managerPhone = company.managerPhone || company.mainPhone;

// Формирование прямой ссылки в мессенджер менеджера Максима
const tgRaw = company.telegramContact || company.whatsappPhone || company.managerPhone || company.mainPhone;
const tgClean = tgRaw.replace(/[^\d+]/g, '');
const messengerUrl = tgRaw.startsWith('http') 
  ? tgRaw 
  : (tgRaw.startsWith('@') 
      ? `https://t.me/${tgRaw.slice(1)}` 
      : `https://t.me/${tgClean.startsWith('+') ? tgClean : `+${tgClean}`}`);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="fixed top-3 sm:top-6 inset-x-0 z-50 max-w-7xl mx-auto px-3 sm:px-6">
  <nav class="relative flex items-center justify-between gap-2 sm:gap-4 px-4 sm:px-6 py-2.5 sm:py-3.5 rounded-2xl bg-white/90 dark:bg-[#181a1f]/90 border border-zinc-200/80 dark:border-white/[0.08] backdrop-blur-xl shadow-lg shadow-black/[0.03] dark:shadow-black/20 transition-all duration-300">
    
    <!-- Логотип + Главная -->
    <a href={`${base}/`} class="flex items-center gap-2.5 sm:gap-3.5 group shrink-0">
      <div class="relative w-8 h-8 rounded-xl overflow-hidden bg-zinc-100 dark:bg-white/[0.06] border border-zinc-200 dark:border-white/[0.1] flex items-center justify-center p-1.5 transition-transform duration-300 group-hover:scale-105">
        <img 
          src={`${base}/image/logo.png`} 
          alt={company.brand} 
          class="w-full h-full object-contain"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" 
        />
        <span class="hidden text-xs font-black font-mono tracking-tighter text-[#0d9488] dark:text-[#3dd68c]">
          БХ
        </span>
      </div>

      <div class="flex flex-col">
        <span class="text-sm sm:text-base font-extrabold tracking-tight text-zinc-900 dark:text-[#f0f2f5] group-hover:text-[#0d9488] dark:group-hover:text-[#3dd68c] transition-colors leading-none">
          {company.brand}
        </span>
        <span class="text-[9px] sm:text-[10px] font-mono text-zinc-400 mt-0.5 sm:mt-1 leading-none hidden xs:inline-block">
          Склад в Омске
        </span>
      </div>
    </a>

    <!-- Строка поиска (Desktop) -->
    <form action={`${base}/catalog`} method="GET" class="relative hidden lg:flex items-center flex-1 max-w-xs">
      <svg class="absolute left-3.5 w-4 h-4 text-zinc-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input 
        type="text" 
        name="search" 
        placeholder="Поиск по номенклатуре..." 
        class="w-full pl-10 pr-4 py-2 rounded-xl bg-zinc-100 dark:bg-white/[0.05] border border-transparent focus:border-[#3dd68c] text-xs font-mono text-zinc-900 dark:text-[#f0f2f5] placeholder-zinc-400 focus:outline-none transition"
      />
    </form>

    <!-- Навигация (Desktop) -->
    <div class="hidden md:flex items-center gap-5 lg:gap-6 text-xs font-mono font-medium text-zinc-600 dark:text-zinc-400 shrink-0">
      <a href={`${base}/catalog`} class="hover:text-zinc-900 dark:hover:text-white transition-colors">Каталог</a>
      <a href={`${base}/collections`} class="hover:text-zinc-900 dark:hover:text-white transition-colors">Подборки</a>
      <a href={`${base}/articles`} class="hover:text-zinc-900 dark:hover:text-white transition-colors">Статьи</a>
      <a href={`${base}/contacts`} class="hover:text-zinc-900 dark:hover:text-white transition-colors">Контакты</a>
    </div>

    <!-- Кнопки справа -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      
      <!-- Ссылка в мессенджер: Макс -->
      <a 
        href={messengerUrl}
        target="_blank"
        rel="noopener noreferrer"
        title="Написать менеджеру Максу в мессенджер" 
        class="flex items-center gap-1.5 sm:gap-2 px-3 sm:px-3.5 py-1.5 sm:py-2 rounded-xl bg-[#3dd68c]/15 text-[#0b633b] dark:text-[#3dd68c] hover:bg-[#3dd68c] hover:text-[#111215] text-xs font-mono font-bold border border-[#3dd68c]/30 transition-all duration-300 shadow-sm"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-[#3dd68c] animate-pulse"></span>
        <span>Макс</span>
      </a>

      <!-- Переключатель темы -->
      <button id="theme-toggle" type="button" aria-label="Сменить тему" class="p-2 rounded-xl text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-white/[0.06] transition-colors">
        <svg class="hidden dark:block w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="block dark:hidden w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <!-- Бургер-кнопка (Mobile) -->
      <button 
        id="mobile-menu-btn" 
        type="button" 
        aria-label="Открыть меню" 
        class="md:hidden p-2 rounded-xl text-zinc-700 dark:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-white/[0.06] transition-colors focus:outline-none"
      >
        <svg id="burger-icon" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </nav>

  <!-- Мобильное выпадающее меню -->
  <div 
    id="mobile-menu-dropdown" 
    class="hidden md:hidden mt-2 p-5 rounded-3xl bg-white/95 dark:bg-[#181a1f]/95 border border-zinc-200/80 dark:border-white/[0.1] backdrop-blur-2xl shadow-2xl space-y-4 transition-all duration-300"
  >
    <!-- Мобильный поиск -->
    <form action={`${base}/catalog`} method="GET" class="relative w-full">
      <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input 
        type="text" 
        name="search" 
        placeholder="Поиск по номенклатуре..." 
        class="w-full pl-10 pr-4 py-3 rounded-xl bg-zinc-100 dark:bg-white/[0.05] border border-transparent focus:border-[#3dd68c] text-xs font-mono text-zinc-900 dark:text-[#f0f2f5] placeholder-zinc-400 focus:outline-none transition"
      />
    </form>

    <!-- Ссылки -->
    <div class="grid grid-cols-2 gap-2 pt-1 font-mono text-xs font-semibold">
      <a href={`${base}/catalog`} class="p-3 rounded-xl bg-zinc-50 dark:bg-[#111215] border border-zinc-200/60 dark:border-white/[0.04] text-zinc-800 dark:text-zinc-200 hover:border-[#3dd68c] transition text-center">
        Каталог
      </a>
      <a href={`${base}/collections`} class="p-3 rounded-xl bg-zinc-50 dark:bg-[#111215] border border-zinc-200/60 dark:border-white/[0.04] text-zinc-800 dark:text-zinc-200 hover:border-[#3dd68c] transition text-center">
        Подборки
      </a>
      <a href={`${base}/articles`} class="p-3 rounded-xl bg-zinc-50 dark:bg-[#111215] border border-zinc-200/60 dark:border-white/[0.04] text-zinc-800 dark:text-zinc-200 hover:border-[#3dd68c] transition text-center">
        Статьи
      </a>
      <a href={`${base}/contacts`} class="p-3 rounded-xl bg-zinc-50 dark:bg-[#111215] border border-zinc-200/60 dark:border-white/[0.04] text-zinc-800 dark:text-zinc-200 hover:border-[#3dd68c] transition text-center">
        Контакты
      </a>
    </div>

    <!-- Связь с менеджером в мобильном меню -->
    <div class="pt-3 border-t border-zinc-100 dark:border-white/[0.06] flex items-center justify-between gap-3">
      <div class="space-y-0.5">
        <span class="text-[10px] font-mono text-zinc-400 block">Менеджер отдела продаж:</span>
        <span class="text-xs font-mono font-bold text-zinc-900 dark:text-white">Максим ({managerPhone})</span>
      </div>
      <a 
        href={messengerUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="px-3.5 py-2 rounded-xl bg-[#3dd68c]/15 text-[#0b633b] dark:text-[#3dd68c] hover:bg-[#3dd68c] hover:text-[#111215] text-xs font-mono font-bold border border-[#3dd68c]/30 transition shadow-sm flex items-center gap-1.5 shrink-0"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-[#3dd68c] animate-pulse"></span>
        <span>Мессенджер</span>
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menuDropdown = document.getElementById('mobile-menu-dropdown');
  const burgerIcon = document.getElementById('burger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (menuBtn && menuDropdown) {
    menuBtn.addEventListener('click', () => {
      const isHidden = menuDropdown.classList.contains('hidden');
      if (isHidden) {
        menuDropdown.classList.remove('hidden');
        burgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      } else {
        menuDropdown.classList.add('hidden');
        burgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      }
    });

    menuDropdown.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menuDropdown.classList.add('hidden');
        burgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>