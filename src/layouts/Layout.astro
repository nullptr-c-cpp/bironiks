---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import company from '../data/company.json';
import database from '../data/database.json';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "БИРОНИКС — Магазин-склад изоляционных материалов в Омске", 
  description = "Продажа строительной, гидро- и теплоизоляции в розницу и оптом со склада в Омске." 
} = Astro.props;

const formatPhone = (phone: string) => phone.replace(/[^\d+]/g, '');
const managerPhone = company.managerPhone || company.mainPhone;
---

<!DOCTYPE html>
<html lang="ru" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <script is:inline>
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'light') {
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.classList.add('dark');
    }
  </script>

  <style is:global>
    :root { font-family: 'Plus Jakarta Sans', -apple-system, sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
    .cosmic-noise {
      background-image: radial-gradient(rgba(148, 163, 184, 0.08) 1px, transparent 0);
      background-size: 32px 32px;
    }
    .dark .cosmic-noise {
      background-image: radial-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 0);
    }

    @keyframes float-pulse {
      0%, 100% { transform: translateY(0) scale(1); }
      50% { transform: translateY(-4px) scale(1.02); }
    }
    .animate-float-pulse {
      animation: float-pulse 3s ease-in-out infinite;
    }

    /* СТИЛИ ПЕЧАТИ В PDF */
    @media print {
      header, footer, main, #order-modal, #order-sheet-trigger, #copy-toast, .cosmic-noise {
        display: none !important;
      }
      #print-container {
        display: block !important;
        position: static !important;
        visibility: visible !important;
        width: 100% !important;
        background: #ffffff !important;
        color: #000000 !important;
        padding: 0 !important;
      }
      #print-container * {
        visibility: visible !important;
        color: #000000 !important;
      }
    }
  </style>
</head>

<body class="bg-[#f8f9fa] dark:bg-[#111215] text-zinc-900 dark:text-[#e3e6ed] antialiased selection:bg-[#3dd68c]/30 selection:text-[#0b633b] dark:selection:text-[#3dd68c] transition-colors duration-200 min-h-screen flex flex-col justify-between">

  <div class="fixed inset-0 pointer-events-none cosmic-noise -z-10"></div>
  <div class="fixed top-[-100px] left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-gradient-to-tr from-[#3dd68c]/15 via-[#0d9488]/10 to-transparent blur-[160px] rounded-full pointer-events-none -z-10"></div>

  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-36 pb-24 w-full flex-1">
    <slot />
  </main>

  <Footer />

  <!-- ПЛАВАЮЩИЙ ТРИГГЕР ЛИСТА ЗАЯВКИ -->
  <div id="order-sheet-trigger" class="fixed bottom-8 right-8 z-40 hidden animate-float-pulse">
    <button 
      type="button" 
      class="px-6 py-4 rounded-2xl bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 text-sm font-mono font-bold shadow-2xl flex items-center gap-3.5 border border-[#3dd68c]/40 hover:scale-105 transition-all group"
    >
      <span class="relative flex h-3 w-3">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#3dd68c] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-3 w-3 bg-[#3dd68c]"></span>
      </span>
      <span>Лист заявки:</span>
      <span id="order-sheet-count" class="px-2.5 py-0.5 rounded-lg bg-[#3dd68c] text-zinc-950 font-black text-xs">
        0
      </span>
    </button>
  </div>

  <!-- МОДАЛЬНОЕ ОКНО ЛИСТА ЗАКАЗА -->
  <div id="order-modal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-md hidden items-center justify-center p-4 sm:p-6 transition-all duration-300">
    <div class="bg-white dark:bg-[#181a1f] border border-zinc-200 dark:border-white/[0.1] rounded-3xl max-w-3xl w-full p-6 sm:p-10 space-y-6 shadow-2xl max-h-[92vh] flex flex-col justify-between overflow-hidden">
      
      <div class="flex items-start justify-between pb-4 border-b border-zinc-200 dark:border-white/[0.06]">
        <div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#3dd68c]"></span>
            <span class="text-xs font-mono uppercase tracking-widest text-[#0d9488] dark:text-[#3dd68c]">Оформление по звонку</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 dark:text-[#f0f2f5] mt-1">
            Лист выбранных позиций
          </h2>
        </div>
        <button id="close-modal-btn" class="p-2 rounded-xl text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition">
          ✕
        </button>
      </div>

      <div id="modal-items-list" class="overflow-y-auto space-y-3 pr-2 flex-1 max-h-[280px]">
        <!-- Заполняется JS -->
      </div>

      <div class="flex items-center justify-between py-3 px-4 rounded-2xl bg-zinc-50 dark:bg-[#111215] border border-zinc-200/80 dark:border-white/[0.04]">
        <div>
          <span class="text-xs font-mono text-zinc-500 block">Ориентировочная сумма:</span>
          <span id="modal-total-price" class="text-2xl font-extrabold font-mono text-zinc-900 dark:text-[#f0f2f5]">0 ₽</span>
        </div>

        <button 
          id="download-order-pdf-btn" 
          type="button" 
          class="px-4 py-2.5 rounded-xl bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 text-xs font-mono font-bold hover:bg-[#3dd68c] dark:hover:bg-[#3dd68c] dark:hover:text-zinc-950 transition flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span>Сохранить заявку в PDF</span>
        </button>
      </div>

      <!-- БЛОКИ СВЯЗИ: ТЕЛЕФОН МАКСА И ПОЧТА -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
        
        <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-[#111215] border border-zinc-200 dark:border-white/[0.06] flex flex-col justify-between space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold px-2 py-0.5 rounded bg-[#3dd68c]/20 text-[#0b633b] dark:text-[#3dd68c]">
              Менеджер Макс
            </span>
            <button data-copy={managerPhone} title="Скопировать телефон" class="text-xs font-mono text-zinc-400 hover:text-zinc-900 dark:hover:text-white underline decoration-dotted transition">
              копировать
            </button>
          </div>

          <div class="text-lg font-bold font-mono text-zinc-900 dark:text-white">
            {managerPhone}
          </div>

          <a 
            href={`tel:${formatPhone(managerPhone)}`} 
            class="w-full py-2.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-white dark:bg-white dark:text-zinc-900 text-xs font-bold text-center transition flex items-center justify-center gap-2"
          >
            <span>Позвонить и заказать</span>
          </a>
        </div>

        <div class="p-4 rounded-2xl bg-zinc-50 dark:bg-[#111215] border border-zinc-200 dark:border-white/[0.06] flex flex-col justify-between space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-zinc-500">Отдел продаж:</span>
            <button data-copy={company.emailSales} title="Скопировать почту" class="text-xs font-mono text-zinc-400 hover:text-zinc-900 dark:hover:text-white underline decoration-dotted transition">
              копировать
            </button>
          </div>

          <div class="text-sm font-bold font-mono text-zinc-900 dark:text-white truncate">
            {company.emailSales}
          </div>

          <button 
            id="email-sheet-btn" 
            type="button" 
            class="w-full py-2.5 rounded-xl bg-[#3dd68c]/15 text-[#0b633b] dark:text-[#3dd68c] border border-[#3dd68c]/30 text-xs font-mono font-bold hover:bg-[#3dd68c] hover:text-[#111215] transition flex items-center justify-center gap-2"
          >
            <span>Отправить список на Email</span>
          </button>
        </div>

      </div>

    </div>
  </div>

  <!-- ЕДИНЫЙ ПЕЧАТНЫЙ КОНТЕЙНЕР ДЛЯ PDF -->
  <div id="print-container" class="hidden">
    <div id="print-content"></div>
  </div>

  <!-- Toast копирования -->
  <div id="copy-toast" class="fixed bottom-8 left-8 z-50 transform translate-y-20 opacity-0 pointer-events-none transition-all duration-300 px-4 py-2.5 rounded-xl bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 text-xs font-mono font-medium shadow-2xl flex items-center gap-2">
    <span class="w-2 h-2 rounded-full bg-[#3dd68c]"></span>
    <span id="copy-toast-text">Скопировано в буфер</span>
  </div>

  <script is:inline define:vars={{ salesEmail: company.emailSales, phoneNum: managerPhone, companyName: company.name, companyAddress: company.warehouseAddress, productsCatalog: database.products }}>
    // 1. ТЕМА
    document.addEventListener('click', (e) => {
      if (e.target.closest('#theme-toggle')) {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      }
    });

    // 2. КОРЗИНА / ЛИСТ ЗАЯВКИ
    window.orderSheet = JSON.parse(localStorage.getItem('bironiks_sheet') || '[]');

    function saveSheet() {
      localStorage.setItem('bironiks_sheet', JSON.stringify(window.orderSheet));
      updateSheetTrigger();
    }

    function updateSheetTrigger() {
      const countEl = document.getElementById('order-sheet-count');
      const trigger = document.getElementById('order-sheet-trigger');
      const totalCount = window.orderSheet.reduce((acc, item) => acc + item.qty, 0);

      if (countEl) countEl.textContent = totalCount;
      if (trigger) {
        trigger.style.display = totalCount > 0 ? 'block' : 'none';
      }
    }

    window.addToOrderSheetWithQty = function(item, qtyToAdd = 1) {
      const existing = window.orderSheet.find(i => i.id === item.id);
      if (existing) {
        existing.qty += qtyToAdd;
      } else {
        window.orderSheet.push({ ...item, qty: qtyToAdd });
      }
      saveSheet();
      showToast(`В заявке: ${item.title} (${qtyToAdd} шт.)`);
    };

    window.removeFromOrderSheet = function(id) {
      window.orderSheet = window.orderSheet.filter(i => i.id !== id);
      saveSheet();
      renderModalList();
    };

    window.changeQty = function(id, delta) {
      const item = window.orderSheet.find(i => i.id === id);
      if (item) {
        item.qty += delta;
        if (item.qty <= 0) {
          window.removeFromOrderSheet(id);
          return;
        }
        saveSheet();
        renderModalList();
      }
    };

    function renderModalList() {
      const listEl = document.getElementById('modal-items-list');
      const totalEl = document.getElementById('modal-total-price');
      if (!listEl) return;

      if (window.orderSheet.length === 0) {
        listEl.innerHTML = '<div class="text-center py-8 text-xs font-mono text-zinc-400">Лист заявки пуст. Выберите материалы в каталоге.</div>';
        if (totalEl) totalEl.textContent = '0 ₽';
        return;
      }

      let totalSum = 0;
      listEl.innerHTML = window.orderSheet.map(item => {
        const itemSum = item.price ? item.price * item.qty : 0;
        totalSum += itemSum;
        return `
          <div class="flex items-center justify-between p-3.5 rounded-2xl bg-zinc-50 dark:bg-[#111215] border border-zinc-200 dark:border-white/[0.04]">
            <div class="space-y-0.5 max-w-[55%]">
              <div class="text-xs font-bold text-zinc-900 dark:text-[#f0f2f5] truncate">${item.title}</div>
              <div class="text-[11px] font-mono text-zinc-400">${item.price ? `${item.price} ₽ / ${item.unit}` : 'Цена по согласованию'}</div>
            </div>

            <div class="flex items-center gap-3">
              <div class="flex items-center gap-2 bg-white dark:bg-[#181a1f] border border-zinc-200 dark:border-white/[0.08] rounded-xl px-2 py-1">
                <button type="button" onclick="changeQty('${item.id}', -1)" class="text-xs text-zinc-400 hover:text-zinc-900 dark:hover:text-white px-1 font-bold">−</button>
                <span class="text-xs font-mono font-bold text-zinc-800 dark:text-zinc-200 min-w-[20px] text-center">${item.qty}</span>
                <button type="button" onclick="changeQty('${item.id}', 1)" class="text-xs text-zinc-400 hover:text-zinc-900 dark:hover:text-white px-1 font-bold">+</button>
              </div>
              <span class="text-xs font-mono font-bold text-zinc-900 dark:text-[#f0f2f5] min-w-[70px] text-right">
                ${itemSum > 0 ? `${itemSum} ₽` : '—'}
              </span>
              <button type="button" onclick="removeFromOrderSheet('${item.id}')" class="text-zinc-400 hover:text-rose-500 text-xs px-1">✕</button>
            </div>
          </div>
        `;
      }).join('');

      if (totalEl) totalEl.textContent = totalSum > 0 ? `${totalSum} ₽` : 'По согласованию';
    }

    // 3. ФУНКЦИЯ ПЕЧАТИ В PDF ДЛЯ СМЕТЫ И ПОЛНОГО ПРАЙСА
    function printHtmlDocument(titleDoc, rowsHtml, totalSumStr = '') {
      const container = document.getElementById('print-content');
      if (!container) return;

      const dateStr = new Date().toLocaleDateString('ru-RU');

      container.innerHTML = `
        <div style="padding: 20px; font-family: sans-serif; color: #000; background: #fff;">
          <div style="display:flex; justify-content:space-between; border-bottom:2px solid #000; padding-bottom:12px; margin-bottom:16px;">
            <div>
              <h1 style="font-size:18px; font-weight:bold; margin:0 0 4px 0;">${companyName}</h1>
              <p style="font-size:11px; margin:0;">Офис и склад: ${companyAddress}</p>
              <p style="font-size:11px; margin:2px 0 0 0;">Телефон: ${phoneNum} (Макс) | Email: ${salesEmail}</p>
              <p style="font-size:11px; margin:2px 0 0 0;">Способы оплаты: Безналичный расчет с НДС, наличный расчет, оплата по QR-коду</p>
            </div>
            <div style="text-align:right;">
              <h2 style="font-size:14px; font-weight:bold; margin:0;">${titleDoc}</h2>
              <p style="font-size:11px; margin:4px 0 0 0;">Дата: ${dateStr}</p>
            </div>
          </div>

          <table style="width:100%; border-collapse:collapse; font-size:11px; margin-bottom:16px;">
            <thead>
              <tr style="background:#eee; text-align:left;">
                <th style="border:1px solid #ccc; padding:6px;">№</th>
                <th style="border:1px solid #ccc; padding:6px;">Наименование продукции</th>
                <th style="border:1px solid #ccc; padding:6px; text-align:center;">Кол-во</th>
                <th style="border:1px solid #ccc; padding:6px; text-align:right;">Цена</th>
                <th style="border:1px solid #ccc; padding:6px; text-align:right;">Сумма</th>
              </tr>
            </thead>
            <tbody>
              ${rowsHtml}
            </tbody>
          </table>

          ${totalSumStr ? `<div style="text-align:right; font-size:14px; font-weight:bold; margin-bottom:16px;">${totalSumStr}</div>` : ''}

          <div style="font-size:10px; border-top:1px solid #ccc; padding-top:8px; color:#555;">
            * Заказ и доставка согласовываются с отделом продаж по телефону ${phoneNum}. Отгрузка со склада в г. Омске.
          </div>
        </div>
      `;

      window.print();
    }

    // Печать Сметы из окна
    document.addEventListener('click', (e) => {
      if (e.target.closest('#download-order-pdf-btn')) {
        if (!window.orderSheet.length) {
          showToast('Лист заявки пуст');
          return;
        }
        let total = 0;
        const rows = window.orderSheet.map((item, idx) => {
          const sum = item.price ? item.price * item.qty : 0;
          total += sum;
          return `
            <tr>
              <td style="border:1px solid #ccc; padding:6px; text-align:center;">${idx + 1}</td>
              <td style="border:1px solid #ccc; padding:6px;">${item.title}</td>
              <td style="border:1px solid #ccc; padding:6px; text-align:center;">${item.qty} ${item.unit || 'шт'}</td>
              <td style="border:1px solid #ccc; padding:6px; text-align:right;">${item.price ? `${item.price} ₽` : 'по согл.'}</td>
              <td style="border:1px solid #ccc; padding:6px; text-align:right;">${sum > 0 ? `${sum} ₽` : '—'}</td>
            </tr>
          `;
        }).join('');

        printHtmlDocument('СПЕЦИФИКАЦИЯ ЗАЯВКИ', rows, `Ориентировочная сумма: ${total > 0 ? `${total} ₽` : 'По согласованию'}`);
      }
    });

    // Функция печати ВСЕГО прайс-листа каталога
    window.downloadFullCatalogPdf = function() {
      let idx = 1;
      let rows = '';
      productsCatalog.forEach(p => {
        p.variants.forEach(v => {
          const priceEntries = Object.entries(v.prices);
          const priceText = priceEntries.length ? `${priceEntries[0][1]} ₽ / ${priceEntries[0][0]}` : 'По согласованию';
          rows += `
            <tr>
              <td style="border:1px solid #ccc; padding:6px; text-align:center;">${idx++}</td>
              <td style="border:1px solid #ccc; padding:6px;">${p.title} — ${v.title}</td>
              <td style="border:1px solid #ccc; padding:6px; text-align:center;">В наличии</td>
              <td style="border:1px solid #ccc; padding:6px; text-align:right;" colspan="2">${priceText}</td>
            </tr>
          `;
        });
      });

      printHtmlDocument('ПРАЙС-ЛИСТ СКЛАДСКОЙ ПРОДУКЦИИ', rows);
    };

    // 4. ОБРАБОТЧИКИ МОДАЛЬНОГО ОКНА
    document.addEventListener('click', (e) => {
      if (e.target.closest('#order-sheet-trigger')) {
        renderModalList();
        const modal = document.getElementById('order-modal');
        if (modal) modal.style.display = 'flex';
      }
      if (e.target.closest('#close-modal-btn') || e.target.id === 'order-modal') {
        const modal = document.getElementById('order-modal');
        if (modal) modal.style.display = 'none';
      }
      if (e.target.closest('#email-sheet-btn')) {
        let text = `Заявка на изоляционные материалы (${companyName}):\n\n`;
        let totalSum = 0;
        window.orderSheet.forEach((item, idx) => {
          const itemSum = item.price ? item.price * item.qty : 0;
          totalSum += itemSum;
          text += `${idx + 1}. ${item.title} — ${item.qty} шт. (${itemSum > 0 ? `${itemSum} ₽` : 'цена по согласованию'})\n`;
        });
        if (totalSum > 0) text += `\nОриентировочная сумма: ${totalSum} ₽`;
        text += `\n\nСклад и офис: ${companyAddress}\nТелефон для связи: ${phoneNum} (Макс)`;

        const subject = encodeURIComponent('Заявка на расчет материалов со склада в Омске');
        const body = encodeURIComponent(text);
        window.location.href = `mailto:${salesEmail}?subject=${subject}&body=${body}`;
      }
    });

    // 5. TOAST И КОПИРОВАНИЕ
    function showToast(msg) {
      const toast = document.getElementById('copy-toast');
      const toastText = document.getElementById('copy-toast-text');
      if (toast && toastText) {
        toastText.textContent = msg;
        toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
        setTimeout(() => {
          toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
        }, 2200);
      }
    }

    document.addEventListener('click', (e) => {
      const target = e.target.closest('[data-copy]');
      if (!target) return;
      const text = target.getAttribute('data-copy');
      if (text) {
        navigator.clipboard.writeText(text);
        showToast(`Скопировано: ${text}`);
      }
    });

    updateSheetTrigger();
  </script>
</body>
</html>