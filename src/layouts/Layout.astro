---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import company from '../data/company.json';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "БИРОНИКС — Изоляционные материалы со склада в Омске", 
  description = "Прямые поставки строительных и изоляционных материалов." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ru" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Скрипт инициализации темы до рендеринга страницы -->
  <script is:inline>
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'light') {
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.classList.add('dark');
    }
  </script>

  <style is:global>
    :root { font-family: 'Plus Jakarta Sans', -apple-system, sans-serif; }
    .font-mono { font-family: 'JetBrains Mono', monospace; }
    .cosmic-noise {
      background-image: radial-gradient(rgba(148, 163, 184, 0.08) 1px, transparent 0);
      background-size: 32px 32px;
    }
    .dark .cosmic-noise {
      background-image: radial-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 0);
    }
  </style>
</head>

<body class="bg-[#f8f9fa] dark:bg-[#111215] text-zinc-900 dark:text-[#e3e6ed] antialiased selection:bg-[#3dd68c]/30 selection:text-[#0b633b] dark:selection:text-[#3dd68c] transition-colors duration-200 min-h-screen flex flex-col justify-between">

  <div class="fixed inset-0 pointer-events-none cosmic-noise -z-10"></div>
  <div class="fixed top-[-100px] left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-gradient-to-tr from-[#3dd68c]/15 via-[#0d9488]/10 to-transparent blur-[160px] rounded-full pointer-events-none -z-10"></div>

  <Header />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-36 pb-24 w-full flex-1">
    <slot />
  </main>

  <Footer />

  <!-- ПЛАВАЮЩАЯ КНОПКА ОТКРЫТИЯ ЛИСТА ЗАЯВКИ -->
  <div id="order-sheet-trigger" class="fixed bottom-6 left-6 z-40 hidden">
    <button type="button" class="px-5 py-3 rounded-2xl bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 text-xs font-mono font-bold shadow-2xl flex items-center gap-3 hover:scale-105 transition-all border border-white/[0.1]">
      <span class="w-2 h-2 rounded-full bg-[#3dd68c] animate-pulse"></span>
      <span>Лист заявки: <strong id="order-sheet-count" class="text-[#3dd68c] dark:text-[#0b633b]">0</strong> поз.</span>
    </button>
  </div>

  <!-- МОДАЛЬНОЕ ОКНО ЛИСТА ЗАЯВКИ (ДЛЯ ЗВОНКА) -->
  <div id="order-modal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-md hidden items-center justify-center p-4">
    <div class="bg-white dark:bg-[#181a1f] border border-zinc-200 dark:border-white/[0.08] rounded-3xl max-w-2xl w-full p-6 sm:p-8 space-y-6 shadow-2xl max-h-[90vh] flex flex-col justify-between">
      
      <div class="flex items-center justify-between pb-4 border-b border-zinc-200 dark:border-white/[0.06]">
        <div>
          <span class="text-xs font-mono uppercase tracking-widest text-[#0d9488] dark:text-[#3dd68c]">Оформление по звонку</span>
          <h2 class="text-xl sm:text-2xl font-extrabold text-zinc-900 dark:text-[#f0f2f5]">Лист выбранных позиций</h2>
        </div>
        <button id="close-modal-btn" class="p-2 rounded-xl text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition">
          ✕
        </button>
      </div>

      <!-- Список позиций с возможностью изменения количества -->
      <div id="modal-items-list" class="overflow-y-auto space-y-3 pr-2 flex-1 max-h-[340px]">
        <!-- Заполняется реактивно -->
      </div>

      <div class="space-y-4 pt-4 border-t border-zinc-200 dark:border-white/[0.06]">
        <!-- Итог и дисклеймер -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <div>
            <span class="text-xs font-mono text-zinc-500 block">Ориентировочная сумма:</span>
            <span id="modal-total-price" class="text-2xl font-extrabold font-mono text-zinc-900 dark:text-[#f0f2f5]">0 ₽</span>
          </div>
          <div class="text-[11px] font-mono text-zinc-400 text-left sm:text-right max-w-xs">
            Заказ и доставка согласовываются с менеджером. Оплата при получении или по счету.
          </div>
        </div>

        <!-- Кнопки действий -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
          <a href={`tel:${company.mainPhone.replace(/[^\d+]/g, '')}`} class="py-3 px-4 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-white dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200 text-xs font-bold text-center transition flex items-center justify-center gap-2">
            <span>Позвонить</span>
          </a>
          <button id="copy-sheet-btn" class="py-3 px-4 rounded-xl bg-[#3dd68c]/15 text-[#0b633b] dark:text-[#3dd68c] border border-[#3dd68c]/30 text-xs font-mono font-bold hover:bg-[#3dd68c] hover:text-[#111215] transition">
            Скопировать для звонка
          </button>
          <button id="email-sheet-btn" class="py-3 px-4 rounded-xl bg-zinc-100 hover:bg-zinc-200 dark:bg-white/[0.04] dark:hover:bg-white/[0.08] text-zinc-700 dark:text-zinc-300 text-xs font-mono font-semibold transition">
            Отправить на Email
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Toast копирования -->
  <div id="copy-toast" class="fixed bottom-6 right-6 z-50 transform translate-y-20 opacity-0 pointer-events-none transition-all duration-300 px-4 py-2.5 rounded-xl bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 text-xs font-mono font-medium shadow-2xl flex items-center gap-2">
    <span class="w-2 h-2 rounded-full bg-[#3dd68c]"></span>
    <span id="copy-toast-text">Скопировано в буфер</span>
  </div>

  <!-- Глобальный скрипт тем, копирования и корзины звонка -->
  <script is:inline define:vars={{ salesEmail: company.emailSales, phoneNum: company.mainPhone }}>
    // 1. ПЕРЕКЛЮЧЕНИЕ ТЕМЫ (ДЕЛЕГИРОВАНИЕ)
    document.addEventListener('click', (e) => {
      if (e.target.closest('#theme-toggle')) {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      }
    });

    // 2. СИСТЕМА ЛИСТА ЗАЯВКИ (ОФЛАЙН-КОРЗИНА)
    window.orderSheet = JSON.parse(localStorage.getItem('bironiks_sheet') || '[]');

    function saveSheet() {
      localStorage.setItem('bironiks_sheet', JSON.stringify(window.orderSheet));
      updateSheetTrigger();
    }

    function updateSheetTrigger() {
      const countEl = document.getElementById('order-sheet-count');
      const trigger = document.getElementById('order-sheet-trigger');
      const totalCount = window.orderSheet.reduce((acc, item) => acc + item.qty, 0);

      if (countEl) countEl.textContent = totalCount;
      if (trigger) {
        trigger.style.display = totalCount > 0 ? 'block' : 'none';
      }
    }

    window.addToOrderSheet = function(item) {
      const existing = window.orderSheet.find(i => i.id === item.id);
      if (existing) {
        existing.qty += 1;
      } else {
        window.orderSheet.push({ ...item, qty: 1 });
      }
      saveSheet();
      showToast(`Добавлено в заявку: ${item.title}`);
    };

    window.removeFromOrderSheet = function(id) {
      window.orderSheet = window.orderSheet.filter(i => i.id !== id);
      saveSheet();
      renderModalList();
    };

    window.changeQty = function(id, delta) {
      const item = window.orderSheet.find(i => i.id === id);
      if (item) {
        item.qty += delta;
        if (item.qty <= 0) {
          window.removeFromOrderSheet(id);
          return;
        }
        saveSheet();
        renderModalList();
      }
    };

    function renderModalList() {
      const listEl = document.getElementById('modal-items-list');
      const totalEl = document.getElementById('modal-total-price');
      if (!listEl) return;

      if (window.orderSheet.length === 0) {
        listEl.innerHTML = '<div class="text-center py-8 text-xs font-mono text-zinc-400">Лист заявки пуст. Выберите позиции в каталоге.</div>';
        if (totalEl) totalEl.textContent = '0 ₽';
        return;
      }

      let totalSum = 0;
      listEl.innerHTML = window.orderSheet.map(item => {
        const itemSum = item.price ? item.price * item.qty : 0;
        totalSum += itemSum;
        return `
          <div class="flex items-center justify-between p-3.5 rounded-2xl bg-zinc-50 dark:bg-[#111215] border border-zinc-200 dark:border-white/[0.04]">
            <div class="space-y-0.5 max-w-[60%]">
              <div class="text-xs font-bold text-zinc-900 dark:text-[#f0f2f5] truncate">${item.title}</div>
              <div class="text-[11px] font-mono text-zinc-400">${item.price ? `${item.price} ₽ / ${item.unit}` : 'Цена по запросу'}</div>
            </div>

            <div class="flex items-center gap-3">
              <div class="flex items-center gap-2 bg-white dark:bg-[#181a1f] border border-zinc-200 dark:border-white/[0.08] rounded-xl px-2 py-1">
                <button type="button" onclick="changeQty('${item.id}', -1)" class="text-xs text-zinc-400 hover:text-zinc-900 dark:hover:text-white px-1">−</button>
                <span class="text-xs font-mono font-bold text-zinc-800 dark:text-zinc-200 min-w-[20px] text-center">${item.qty}</span>
                <button type="button" onclick="changeQty('${item.id}', 1)" class="text-xs text-zinc-400 hover:text-zinc-900 dark:hover:text-white px-1">+</button>
              </div>
              <span class="text-xs font-mono font-bold text-zinc-900 dark:text-[#f0f2f5] min-w-[70px] text-right">
                ${itemSum > 0 ? `${itemSum} ₽` : '—'}
              </span>
              <button type="button" onclick="removeFromOrderSheet('${item.id}')" class="text-zinc-400 hover:text-rose-500 text-xs px-1">✕</button>
            </div>
          </div>
        `;
      }).join('');

      if (totalEl) totalEl.textContent = totalSum > 0 ? `${totalSum} ₽` : 'По запросу';
    }

    function generateOrderText() {
      let text = `Заявка на изоляционные материалы (БИРОНИКС):\n\n`;
      let totalSum = 0;
      window.orderSheet.forEach((item, idx) => {
        const itemSum = item.price ? item.price * item.qty : 0;
        totalSum += itemSum;
        text += `${idx + 1}. ${item.title} — ${item.qty} шт. (${itemSum > 0 ? `${itemSum} ₽` : 'цена по согласованию'})\n`;
      });
      if (totalSum > 0) text += `\nОриентировочная сумма: ${totalSum} ₽`;
      text += `\n\nЗаказ и доставка оформляются по согласованию. Телефон: ${phoneNum}`;
      return text;
    }

    // Обработчики модального окна
    document.addEventListener('click', (e) => {
      if (e.target.closest('#order-sheet-trigger')) {
        renderModalList();
        const modal = document.getElementById('order-modal');
        if (modal) modal.style.display = 'flex';
      }
      if (e.target.closest('#close-modal-btn') || e.target.id === 'order-modal') {
        const modal = document.getElementById('order-modal');
        if (modal) modal.style.display = 'none';
      }
      if (e.target.closest('#copy-sheet-btn')) {
        const orderText = generateOrderText();
        navigator.clipboard.writeText(orderText);
        showToast('Список заявки скопирован');
      }
      if (e.target.closest('#email-sheet-btn')) {
        const orderText = generateOrderText();
        const subject = encodeURIComponent('Заявка на расчет материалов со склада');
        const body = encodeURIComponent(orderText);
        window.location.href = `mailto:${salesEmail}?subject=${subject}&body=${body}`;
      }
    });

    // 3. УВЕДОМИТЕЛЬ TOAST
    function showToast(msg) {
      const toast = document.getElementById('copy-toast');
      const toastText = document.getElementById('copy-toast-text');
      if (toast && toastText) {
        toastText.textContent = msg;
        toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
        setTimeout(() => {
          toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
        }, 2200);
      }
    }

    // Делегирование копирования [data-copy]
    document.addEventListener('click', (e) => {
      const target = e.target.closest('[data-copy]');
      if (!target) return;
      const text = target.getAttribute('data-copy');
      if (text) {
        navigator.clipboard.writeText(text);
        showToast(`Скопировано: ${text}`);
      }
    });

    updateSheetTrigger();
  </script>
</body>
</html>