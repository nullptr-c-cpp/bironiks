---
import Layout from '../../layouts/Layout.astro';
import database from '../../data/database.json';
import { getUrl } from '../../utils/paths';

const { collections, products } = database;
---

<Layout title="Отраслевые подборки материалов — БИРОНИКС">
  <div class="space-y-12">
    
    <div>
      <span class="text-xs font-mono uppercase tracking-widest text-[#0d9488] dark:text-[#3dd68c]">Стройматериалы в Омске</span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-[#f0f2f5] mt-1">
        Подборки по назначению
      </h1>
      <p class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base mt-2 max-w-2xl">
        Строительные материалы, сгруппированные под конкретные задачи.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {collections.map(col => {
        const relatedCount = products.filter(p => p.collectionIds?.includes(col.id)).length;
        return (
          <a 
            href={getUrl(`/collections/${col.slug}`)}
            class="group rounded-3xl overflow-hidden bg-white dark:bg-[#181a1f] border border-zinc-200/80 dark:border-white/[0.08] p-8 flex flex-col justify-between hover:border-[#0d9488]/40 dark:hover:border-[#3dd68c]/40 hover:-translate-y-1.5 hover:shadow-xl transition-all duration-500 relative"
          >
            {col.coverImage && (
              <div class="h-48 -mx-8 -mt-8 mb-6 overflow-hidden relative">
                <img src={getUrl(col.coverImage)} alt={col.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                <div class="absolute inset-0 bg-gradient-to-t from-white dark:from-[#181a1f] via-transparent to-transparent"></div>
              </div>
            )}

            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono font-bold text-[#0d9488] dark:text-[#3dd68c] px-3 py-1 rounded-full bg-[#3dd68c]/10 border border-[#3dd68c]/20">
                  {col.badge || 'СТАНДАРТ'}
                </span>
                <span class="text-xs font-mono text-zinc-400">Позиций: {relatedCount}</span>
              </div>

              <h2 class="text-2xl font-extrabold text-zinc-900 dark:text-[#f0f2f5] group-hover:text-[#0d9488] dark:group-hover:text-[#3dd68c] transition-colors">
                {col.title}
              </h2>

              <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed line-clamp-3">
                {col.description}
              </p>
            </div>

            <div class="pt-6 mt-6 border-t border-zinc-200 dark:border-white/[0.06] flex items-center justify-between text-xs font-mono font-bold text-zinc-900 dark:text-[#f0f2f5] group-hover:text-[#0d9488] dark:group-hover:text-[#3dd68c]">
              <span>Смотреть спецификацию</span>
              <span>→</span>
            </div>
          </a>
        );
      })}
    </div>

  </div>
</Layout>