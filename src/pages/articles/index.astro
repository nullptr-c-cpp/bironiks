---
import Layout from '../../layouts/Layout.astro';
import database from '../../data/database.json';

const { articles } = database;
---

<Layout title="База знаний и инструкции по монтажу — БИРОНИКС">
  <div class="space-y-12">
    
    <div>
      <span class="text-xs font-mono uppercase tracking-widest text-[#0d9488] dark:text-[#3dd68c]">Инженерная база знаний</span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-[#f0f2f5] mt-1">
        Руководства и статьи
      </h1>
      <p class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base mt-2 max-w-2xl">
        Практические рекомендации по теплоизоляции, предотвращению мостиков холода и выбору отражающих систем.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {articles.map(art => (
        <a 
          href={`/articles/${art.slug}`}
          class="rounded-3xl bg-white dark:bg-[#181a1f] border border-zinc-200/80 dark:border-white/[0.08] overflow-hidden flex flex-col justify-between hover:border-[#0d9488]/40 dark:hover:border-[#3dd68c]/40 hover:-translate-y-1.5 hover:shadow-xl transition-all duration-300 group"
        >
          {art.media && (
            <div class="h-60 w-full overflow-hidden relative bg-zinc-100 dark:bg-black/40">
              <img 
                src={art.media.posterImage || art.media.url} 
                alt={art.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
              />
              <div class="absolute top-4 left-4 flex gap-2">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-white/90 dark:bg-[#181a1f]/90 backdrop-blur-md text-zinc-800 dark:text-zinc-200 border border-zinc-200 dark:border-white/[0.1]">
                  {art.category}
                </span>
                {art.media.type === 'video' && (
                  <span class="text-[10px] font-mono font-bold px-2.5 py-1 rounded-full bg-[#3dd68c] text-[#111215]">
                    ВИДЕО
                  </span>
                )}
              </div>
            </div>
          )}

          <div class="p-8 space-y-4 flex-1 flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center gap-3 text-xs font-mono text-zinc-400">
                <span>{art.date}</span>
                <span>•</span>
                <span>{art.readTimeMin} мин чтения</span>
              </div>

              <h2 class="text-xl font-bold text-zinc-900 dark:text-[#f0f2f5] group-hover:text-[#0d9488] dark:group-hover:text-[#3dd68c] transition-colors leading-snug">
                {art.title}
              </h2>

              <p class="text-sm text-zinc-600 dark:text-zinc-400 line-clamp-3 leading-relaxed">
                {art.summary}
              </p>
            </div>

            <div class="pt-6 border-t border-zinc-200 dark:border-white/[0.06] flex items-center justify-between text-xs font-mono font-bold text-zinc-900 dark:text-[#f0f2f5] group-hover:text-[#0d9488] dark:group-hover:text-[#3dd68c]">
              <span>Читать статью полностью</span>
              <span>→</span>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</Layout>