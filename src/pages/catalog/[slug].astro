---
import Layout from '../../layouts/Layout.astro';
import database from '../../data/database.json';
import company from '../../data/company.json';
import { getUrl } from '../../utils/paths';

export async function getStaticPaths() {
  return database.products.map(product => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;

const productCollections = database.collections.filter(c => product.collectionIds?.includes(c.id));
const primaryCategory = database.categories.find(c => product.categoryIds?.includes(c.id));

const relatedProducts = database.products
  .filter(p => p.id !== product.id && p.collectionIds?.some(cid => product.collectionIds?.includes(cid)))
  .slice(0, 3);

const formatPhone = (phone: string) => phone.replace(/[^\d+]/g, '');
const defaultVariant = product.variants[0];
const firstPrice = defaultVariant ? Object.values(defaultVariant.prices)[0] : null;

// Product Schema.org
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": `${product.title} — ${defaultVariant.title}`,
  "image": product.coverImage ? [new URL(product.coverImage, 'https://bironiks.ru').href] : [],
  "description": product.description,
  "sku": defaultVariant.sku,
  "brand": {
    "@type": "Brand",
    "name": company.brand
  },
  "offers": {
    "@type": "Offer",
    "url": `https://bironiks.ru/catalog/${product.slug}`,
    "priceCurrency": "RUB",
    "price": firstPrice || "0",
    "availability": "https://schema.org/InStock",
    "itemCondition": "https://schema.org/NewCondition",
    "seller": {
      "@type": "Organization",
      "name": company.name
    }
  }
};

// Breadcrumbs Schema.org
const breadcrumbsSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Главная",
      "item": "https://bironiks.ru/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Каталог",
      "item": "https://bironiks.ru/catalog"
    },
    ...(primaryCategory ? [{
      "@type": "ListItem",
      "position": 3,
      "name": primaryCategory.title,
      "item": `https://bironiks.ru/catalog?category=${primaryCategory.id}`
    }] : []),
    {
      "@type": "ListItem",
      "position": primaryCategory ? 4 : 3,
      "name": product.title,
      "item": `https://bironiks.ru/catalog/${product.slug}`
    }
  ]
};
---

<Layout 
  title={`${product.title} — ${defaultVariant.title} | Каталог ${primaryCategory ? primaryCategory.title : 'товаров'} | БИРОНИКС Омск`} 
  description={`${product.description} Продажа со склада на ул. 20 лет РККА в Омске. Цены от ${firstPrice || 'по согласованию'} ₽.`}
  image={product.coverImage}
  type="product"
  schema={[productSchema, breadcrumbsSchema]}
>
  <div class="space-y-12 sm:space-y-16 lg:space-y-24">

    <!-- ХЛЕБНЫЕ КРОШКИ -->
    <nav class="flex flex-wrap items-center gap-2 text-xs font-mono text-zinc-400">
      <a href={getUrl()} class="hover:text-zinc-900 dark:hover:text-white transition">Главная</a>
      <span>/</span>
      <a href={getUrl("/catalog")} class="hover:text-zinc-900 dark:hover:text-white transition">Каталог</a>
      {primaryCategory && (
        <>
          <span>/</span>
          <a href={getUrl(`/catalog?category=${primaryCategory.id}`)} class="hover:text-zinc-900 dark:hover:text-white transition">
            {primaryCategory.title}
          </a>
        </>
      )}
      <span>/</span>
      <span class="text-zinc-800 dark:text-zinc-200 font-semibold truncate max-w-[200px] sm:max-w-none">
        {product.title}
      </span>
    </nav>

    <!-- ОСНОВНОЙ BENTO-БЛОК ТОВАРА -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-start">

      <!-- ЛЕВАЯ КОЛОНКА -->
      <div class="lg:col-span-5 space-y-4 sm:space-y-6">
        
        <div class="rounded-3xl overflow-hidden bg-white dark:bg-[#181a1f] border border-zinc-200/80 dark:border-white/[0.08] aspect-square relative shadow-sm group">
          {product.coverImage ? (
            <img 
              id="main-product-image" 
              src={product.coverImage} 
              alt={product.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center font-mono text-xs text-zinc-400">
              Нет изображения
            </div>
          )}

          <div class="absolute top-3 left-3 right-3 sm:top-4 sm:left-4 sm:right-4 flex items-center justify-between pointer-events-none">
            <span class="text-[10px] sm:text-[11px] font-mono font-bold text-[#0b633b] dark:text-[#3dd68c] px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full bg-white/95 dark:bg-[#181a1f]/95 backdrop-blur-md border border-[#3dd68c]/30 shadow-sm">
              В наличии
            </span>
            <span class="text-[9px] sm:text-[10px] font-mono text-zinc-600 dark:text-zinc-400 px-2.5 py-0.5 sm:py-1 rounded-full bg-white/90 dark:bg-black/60 backdrop-blur-md">
              Склад в Омске
            </span>
          </div>
        </div>

        {product.certificates && product.certificates.length > 0 && (
          <div class="p-5 sm:p-6 rounded-3xl bg-white dark:bg-[#181a1f] border border-zinc-200/80 dark:border-white/[0.08] space-y-3.5 shadow-sm">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono uppercase tracking-widest text-[#0d9488] dark:text-[#3dd68c] font-bold">
                Документация
              </span>
              <span class="text-[10px] font-mono text-zinc-400">ГОСТ / Паспорта</span>
            </div>

            <div class="space-y-2">
              {product.certificates.map(cert => (
                <a 
                  href={getUrl(cert.url)}
                  target="_blank" 
                  class="flex items-center justify-between p-3 sm:p-3.5 rounded-2xl bg-zinc-50 dark:bg-[#111215] border border-zinc-200/80 dark:border-white/[0.04] text-xs font-mono text-zinc-700 dark:text-zinc-300 hover:border-[#3dd68c]/40 hover:text-zinc-900 dark:hover:text-white transition group"
                >
                  <div class="flex items-center gap-2.5 truncate pr-2">
                    <svg class="w-4 h-4 text-[#0d9488] dark:text-[#3dd68c] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <span class="truncate">{cert.name}</span>
                  </div>
                  <span class="text-[11px] text-zinc-400 group-hover:text-[#3dd68c] font-bold shrink-0">PDF ↗</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="p-5 sm:p-6 rounded-3xl bg-zinc-50 dark:bg-[#111215] border border-zinc-200/80 dark:border-white/[0.06] space-y-2 font-mono text-xs text-zinc-600 dark:text-zinc-400">
          <div class="text-zinc-900 dark:text-white font-bold">Самовывоз и отгрузка в Омске:</div>
          <div>• Офис и склад на ул. 20 лет РККА, 183Б</div>
          <div>• Погрузка за 10–15 минут прямо в ваш транспорт</div>
          <div>• Оплата наличными, картой по QR или безналичным расчетом с НДС</div>
        </div>

      </div>

      <!-- ПРАВАЯ КОЛОНКА -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-8">
        
        <div class="space-y-2.5">
          {productCollections.length > 0 && (
            <div class="flex flex-wrap gap-1.5 sm:gap-2">
              {productCollections.map(c => (
                <a 
                  href={getUrl(`/collections/${c.slug}`)} 
                  class="text-[10px] sm:text-[11px] font-mono font-bold text-[#0b633b] dark:text-[#3dd68c] px-3 py-1 rounded-full bg-[#3dd68c]/15 border border-[#3dd68c]/30 hover:bg-[#3dd68c] hover:text-[#111215] transition"
                >
                  Подборка: {c.title}
                </a>
              ))}
            </div>
          )}

          <h1 id="product-page-title" class="text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-[#f0f2f5] leading-tight">
            {product.title} — {product.variants[0]?.title}
          </h1>
          
          <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
            Оптовая и розничная продажа от 1 штуки со склада в Омске.
          </p>
        </div>

        <!-- ТАБЫ ВАРИАНТОВ -->
        <div class="space-y-2.5">
          <label class="text-xs font-mono uppercase tracking-widest text-zinc-500 font-bold block">
            Выберите типоразмер / модификацию:
          </label>
          <div id="variant-selector" class="flex flex-wrap gap-2">
            {product.variants.map((v, i) => (
              <button 
                type="button"
                data-index={i}
                data-sku={v.sku}
                class="variant-btn px-3.5 py-2.5 sm:px-4 sm:py-3 rounded-2xl border text-xs font-mono font-semibold transition-all duration-200 bg-white dark:bg-[#181a1f] border-zinc-200 dark:border-white/[0.08] text-zinc-700 dark:text-zinc-300 hover:border-[#3dd68c]"
              >
                {v.title}
              </button>
            ))}
          </div>
        </div>

        <!-- СТОИМОСТЬ И КНОПКИ ЗАКАЗА -->
        <div class="p-5 sm:p-8 rounded-3xl bg-white dark:bg-[#181a1f] border border-zinc-200/80 dark:border-white/[0.08] space-y-5 sm:space-y-6 shadow-sm">
          
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 pb-4 sm:pb-6 border-b border-zinc-100 dark:border-white/[0.06]">
            <div>
              <span class="text-[10px] sm:text-xs font-mono uppercase tracking-widest text-zinc-500 block">Стоимость:</span>
              <div id="display-prices" class="flex flex-wrap items-baseline gap-3 sm:gap-4 mt-1">
                <!-- Заполняется JS -->
              </div>
            </div>

            <span class="text-xs font-mono text-zinc-400">
              В наличии на складе в Омске
            </span>
          </div>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            
            <div class="flex items-center justify-between sm:justify-center bg-zinc-100 dark:bg-[#111215] border border-zinc-200 dark:border-white/[0.08] rounded-2xl px-3 py-2 shrink-0">
              <button 
                type="button" 
                id="product-qty-minus" 
                class="w-8 h-8 rounded-xl flex items-center justify-center text-base font-bold text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition"
              >−</button>
              
              <input 
                type="number" 
                id="product-qty-input" 
                value="1" 
                min="1" 
                max="999" 
                class="w-12 text-center bg-transparent font-mono text-sm font-bold text-zinc-900 dark:text-white focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" 
              />
              
              <button 
                type="button" 
                id="product-qty-plus" 
                class="w-8 h-8 rounded-xl flex items-center justify-center text-base font-bold text-zinc-500 hover:text-zinc-900 dark:hover:text-white transition"
              >+</button>
            </div>

            <button 
              id="add-to-sheet-detail-btn" 
              type="button" 
              class="w-full sm:flex-1 py-3.5 sm:py-4 px-5 rounded-2xl bg-[#3dd68c] hover:bg-[#34d399] text-zinc-950 text-xs sm:text-sm font-mono font-bold transition shadow-lg shadow-[#3dd68c]/20 hover:scale-[1.01] flex items-center justify-center gap-2"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
              </svg>
              <span>Добавить в лист заявки</span>
            </button>

            <!-- ИНЛАЙН-РАСКРЫТИЕ ТЕЛЕФОНА -->
            <div class="relative w-full sm:w-auto shrink-0" id="call-btn-container">
              <button 
                type="button"
                id="reveal-phone-btn"
                class="w-full sm:w-auto py-3.5 sm:py-4 px-4 sm:px-5 rounded-2xl bg-zinc-900 hover:bg-zinc-800 text-white dark:bg-white/[0.06] dark:hover:bg-white dark:text-zinc-200 dark:hover:text-zinc-950 text-xs font-mono font-bold transition text-center border border-zinc-700 dark:border-white/[0.08]"
              >
                Заказать по телефону
              </button>

              <div 
                id="revealed-phone-block" 
                class="hidden flex-col sm:flex-row items-center justify-center gap-2 py-2 px-3 rounded-2xl bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 border border-[#3dd68c] w-full"
              >
                <a 
                  href={`tel:${formatPhone(company.mainPhone)}`}
                  data-no-toast="true"
                  class="text-xs font-mono font-bold hover:underline px-2 py-1 flex items-center justify-center gap-1.5"
                >
                  <svg class="w-3.5 h-3.5 text-[#3dd68c] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span>{company.mainPhone}</span>
                </a>
              </div>
            </div>

          </div>

        </div>

        <div class="space-y-2.5">
          <h2 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-[#f0f2f5]">Описание и назначение</h2>
          <p id="display-description" class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 leading-relaxed">
            <!-- Заполняется JS -->
          </p>
        </div>

        <div class="space-y-3">
          <h2 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-[#f0f2f5]">Технические характеристики</h2>
          <div id="display-specs" class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs font-mono">
            <!-- Заполняется JS -->
          </div>
        </div>

      </div>

    </div>

    <!-- СОПУТСТВУЮЩИЕ ТОВАРЫ -->
    {relatedProducts.length > 0 && (
      <section class="pt-8 sm:pt-12 border-t border-zinc-200 dark:border-white/[0.06] space-y-6 sm:space-y-8">
        
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-[#0d9488] dark:text-[#3dd68c]">
              Комплексный монтаж
            </span>
            <h2 class="text-xl sm:text-3xl font-extrabold text-zinc-900 dark:text-[#f0f2f5] mt-1">
              Другие материалы из этой подборки
            </h2>
          </div>
          <a href={getUrl("/catalog")} class="text-xs font-mono font-bold text-[#0d9488] dark:text-[#3dd68c] hover:underline">
            Весь каталог →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
          {relatedProducts.map(relProd => {
            const defaultVar = relProd.variants[0];
            const priceEntries = Object.entries(defaultVar?.prices || {});
            const fullTitle = `${relProd.title} — ${defaultVar.title}`;
            const directUrl = getUrl(`/catalog/${relProd.slug}?variant=${encodeURIComponent(defaultVar.sku)}`);

            return (
              <div class="rounded-3xl bg-white dark:bg-[#181a1f] border border-zinc-200/80 dark:border-white/[0.08] p-4 sm:p-5 flex flex-col justify-between hover:border-[#0d9488]/40 dark:hover:border-[#3dd68c]/40 hover:-translate-y-1.5 hover:shadow-xl transition-all duration-300 group">
                
                <div class="space-y-3">
                  {relProd.coverImage && (
                    <a href={directUrl} class="block h-40 sm:h-44 rounded-2xl overflow-hidden bg-zinc-100 dark:bg-black/40 relative">
                      <img src={relProd.coverImage} alt={fullTitle} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                      <span class="absolute top-2.5 right-2.5 sm:top-3 sm:right-3 text-[10px] font-mono font-bold text-[#0b633b] dark:text-[#3dd68c] px-2.5 py-0.5 sm:py-1 rounded-full bg-white/90 dark:bg-[#181a1f]/90 backdrop-blur-md border border-[#3dd68c]/30">
                        В наличии
                      </span>
                    </a>
                  )}

                  <div>
                    <h3 class="text-sm sm:text-base font-bold text-zinc-900 dark:text-[#f0f2f5] group-hover:text-[#0d9488] dark:group-hover:text-[#3dd68c] transition-colors leading-snug">
                      <a href={directUrl}>{fullTitle}</a>
                    </h3>
                  </div>

                  <div class="flex flex-wrap gap-1">
                    {Object.entries(defaultVar.attributes).slice(0, 2).map(([k, val]) => (
                      <span class="text-[11px] font-mono px-2 py-0.5 rounded-lg bg-zinc-100 dark:bg-[#111215] border border-zinc-200 dark:border-white/[0.04] text-zinc-600 dark:text-zinc-400">
                        {k}: {val}
                      </span>
                    ))}
                  </div>
                </div>

                <div class="pt-3 sm:pt-4 mt-3 sm:mt-4 border-t border-zinc-200 dark:border-white/[0.06] flex items-center justify-between gap-2">
                  <div class="font-mono shrink-0">
                    {priceEntries.length > 0 ? (
                      <div>
                        <span class="text-[9px] sm:text-[10px] text-zinc-500 block uppercase">/ {priceEntries[0][0]}</span>
                        <span class="text-base sm:text-lg font-extrabold text-zinc-900 dark:text-[#f0f2f5]">{priceEntries[0][1]} ₽</span>
                      </div>
                    ) : (
                      <span class="text-xs font-bold text-zinc-400">По согл.</span>
                    )}
                  </div>

                  <button 
                    type="button"
                    onclick={`addToOrderSheetWithQty({ id: '${relProd.id}-${defaultVar.sku}', title: '${fullTitle.replace(/'/g, "\\'")}', price: ${priceEntries.length > 0 ? priceEntries[0][1] : 0}, unit: '${priceEntries.length > 0 ? priceEntries[0][0] : 'шт'}' }, 1)`}
                    class="px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-[#3dd68c]/15 text-[#0b633b] dark:text-[#3dd68c] hover:bg-[#3dd68c] hover:text-[#111215] text-xs font-bold border border-[#3dd68c]/30 transition shrink-0"
                  >
                    + В заявку
                  </button>
                </div>

              </div>
            );
          })}
        </div>

      </section>
    )}

  </div>

  <script is:inline define:vars={{ productData: product }}>
    const variants = productData.variants;
    const baseAttrs = productData.base_attributes || {};
    const baseDesc = productData.description || '';

    const urlParams = new URLSearchParams(window.location.search);
    const requestedSku = urlParams.get('variant');
    let activeIndex = variants.findIndex(v => v.sku === requestedSku);
    if (activeIndex === -1) activeIndex = 0;

    let currentSelectedVariant = variants[activeIndex];
    let selectedQuantity = 1;

    function renderVariant(index) {
      const v = variants[index];
      if (!v) return;
      currentSelectedVariant = v;
      activeIndex = index;

      document.querySelectorAll('.variant-btn').forEach((btn, i) => {
        if (i === index) {
          btn.className = 'variant-btn px-3.5 py-2.5 sm:px-4 sm:py-3 rounded-2xl border text-xs font-mono font-bold transition bg-[#3dd68c]/15 text-[#0b633b] dark:text-[#3dd68c] border-[#3dd68c] shadow-sm';
        } else {
          btn.className = 'variant-btn px-3.5 py-2.5 sm:px-4 sm:py-3 rounded-2xl border text-xs font-mono font-semibold transition bg-white dark:bg-[#181a1f] border-zinc-200 dark:border-white/[0.08] text-zinc-700 dark:text-zinc-300 hover:border-[#3dd68c]';
        }
      });

      const pageTitle = document.getElementById('product-page-title');
      if (pageTitle) {
        pageTitle.textContent = `${productData.title} — ${v.title}`;
      }

      const pricesEl = document.getElementById('display-prices');
      if (pricesEl) {
        pricesEl.innerHTML = Object.entries(v.prices).map(([unit, price]) => `
          <div class="font-mono">
            <span class="text-2xl sm:text-4xl font-extrabold text-zinc-900 dark:text-[#f0f2f5]">${price} ₽</span>
            <span class="text-xs text-zinc-500 uppercase ml-1.5 font-bold">/ ${unit}</span>
          </div>
        `).join('');
      }

      const descEl = document.getElementById('display-description');
      if (descEl) {
        if (v.description_override) {
          descEl.textContent = v.description_override;
        } else if (v.description_addon) {
          descEl.textContent = `${baseDesc} ${v.description_addon}`;
        } else {
          descEl.textContent = baseDesc;
        }
      }

      const mergedAttrs = { ...baseAttrs, ...v.attributes };
      const specsEl = document.getElementById('display-specs');
      if (specsEl) {
        specsEl.innerHTML = Object.entries(mergedAttrs).map(([k, val]) => `
          <div class="flex justify-between items-center p-3 rounded-2xl bg-zinc-50 dark:bg-[#111215] border border-zinc-200/80 dark:border-white/[0.04]">
            <span class="text-zinc-500">${k}:</span>
            <span class="text-zinc-900 dark:text-zinc-200 font-semibold text-right">${val}</span>
          </div>
        `).join('');
      }

      const newUrl = new URL(window.location);
      newUrl.searchParams.set('variant', v.sku);
      window.history.replaceState({}, '', newUrl);
    }

    document.querySelectorAll('.variant-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
        renderVariant(idx);
      });
    });

    const qtyMinus = document.getElementById('product-qty-minus');
    const qtyPlus = document.getElementById('product-qty-plus');
    const qtyInput = document.getElementById('product-qty-input');

    if (qtyMinus && qtyInput) {
      qtyMinus.addEventListener('click', () => {
        let v = parseInt(qtyInput.value || '1', 10);
        if (v > 1) {
          qtyInput.value = v - 1;
          selectedQuantity = v - 1;
        }
      });
    }

    if (qtyPlus && qtyInput) {
      qtyPlus.addEventListener('click', () => {
        let v = parseInt(qtyInput.value || '1', 10);
        qtyInput.value = v + 1;
        selectedQuantity = v + 1;
      });
    }

    if (qtyInput) {
      qtyInput.addEventListener('change', () => {
        let v = parseInt(qtyInput.value || '1', 10);
        if (isNaN(v) || v < 1) v = 1;
        qtyInput.value = v;
        selectedQuantity = v;
      });
    }

    const addBtn = document.getElementById('add-to-sheet-detail-btn');
    if (addBtn) {
      addBtn.addEventListener('click', () => {
        const priceEntries = Object.entries(currentSelectedVariant.prices);
        const price = priceEntries.length ? priceEntries[0][1] : 0;
        const unit = priceEntries.length ? priceEntries[0][0] : 'шт';
        const fullTitle = `${productData.title} — ${currentSelectedVariant.title}`;

        if (typeof window.addToOrderSheetWithQty === 'function') {
          window.addToOrderSheetWithQty({
            id: `${productData.id}-${currentSelectedVariant.sku}`,
            title: fullTitle,
            price: parseFloat(price),
            unit: unit
          }, selectedQuantity);
        }
      });
    }

    const revealBtn = document.getElementById('reveal-phone-btn');
    const revealedBlock = document.getElementById('revealed-phone-block');
    if (revealBtn && revealedBlock) {
      revealBtn.addEventListener('click', () => {
        revealBtn.classList.add('hidden');
        revealedBlock.classList.remove('hidden');
        revealedBlock.classList.add('flex');
      });
    }

    renderVariant(activeIndex);
  </script>
</Layout>