---
import Layout from '../../layouts/Layout.astro';
import database from '../../data/database.json';

const { products, categories } = database;

// Склейка названий
const allVariantCards = products.flatMap(p => {
  return p.variants.map(v => {
    const fullTitle = `${p.title} — ${v.title}`;
    const attrValues = Object.entries(v.attributes).map(([k, val]) => `${k} ${val}`).join(' ');
    const searchableText = `${fullTitle} ${attrValues}`.toLowerCase();
    const firstPriceEntry = Object.entries(v.prices)[0];

    return {
      id: `${p.id}-${v.sku}`,
      fullTitle,
      parentProduct: p,
      variant: v,
      firstPrice: firstPriceEntry ? firstPriceEntry[1] : null,
      firstUnit: firstPriceEntry ? firstPriceEntry[0] : 'шт',
      categoryIds: p.categoryIds || [],
      attributes: { ...p.base_attributes, ...v.attributes },
      searchableText,
      directUrl: `/catalog/${p.slug}?variant=${encodeURIComponent(v.sku)}`
    };
  });
});
---

<Layout title="Каталог строительных и изоляционных материалов — БИРОНИКС">
  <div class="space-y-10">
    
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <span class="text-xs font-mono uppercase tracking-widest text-[#0d9488] dark:text-[#3dd68c]">Розничная и оптовая продажа в Омске</span>
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-zinc-900 dark:text-[#f0f2f5] mt-1">
          Каталог номенклатуры
        </h1>
      </div>
      <div id="catalog-counter" class="text-xs font-mono text-zinc-500">
        Показано: {allVariantCards.length} позиций
      </div>
    </div>

    <!-- САЙДБАР СЛЕВА + ВИТРИНА СПРАВА -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- ЛЕВЫЙ САЙДБАР -->
      <aside class="lg:col-span-4 space-y-6">
        
        <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-[#181a1f] border border-zinc-200/80 dark:border-white/[0.08] space-y-6 shadow-sm sticky top-28">
          
          <div class="flex items-center justify-between pb-3 border-b border-zinc-100 dark:border-white/[0.06]">
            <span class="text-sm font-mono uppercase tracking-widest font-bold text-zinc-900 dark:text-[#f0f2f5]">Категории</span>
            <button id="reset-all-filters" class="text-xs font-mono text-zinc-400 hover:text-rose-500 transition">
              Сбросить
            </button>
          </div>

          <!-- КНОПКИ КАТЕГОРИЙ -->
          <div class="space-y-2">
            <button 
              type="button" 
              data-category="all"
              class="cat-filter-btn active w-full p-3.5 rounded-2xl text-left text-sm font-semibold transition-all flex items-center justify-between bg-[#3dd68c]/15 text-[#0b633b] dark:text-[#3dd68c] border border-[#3dd68c]"
            >
              <span>Все категории</span>
              <span class="text-xs font-mono opacity-80">{allVariantCards.length}</span>
            </button>

            {categories.map(cat => {
              const count = allVariantCards.filter(item => item.categoryIds.includes(cat.id)).length;
              return (
                <button 
                  type="button" 
                  data-category={cat.id}
                  class="cat-filter-btn w-full p-3.5 rounded-2xl text-left text-sm font-semibold transition-all flex items-center justify-between bg-zinc-50 dark:bg-[#111215] text-zinc-700 dark:text-zinc-300 border border-zinc-200/80 dark:border-white/[0.04] hover:border-zinc-300 dark:hover:border-white/[0.2]"
                >
                  <span class="truncate pr-2">{cat.title}</span>
                  <span class="text-xs font-mono opacity-60">{count}</span>
                </button>
              );
            })}
          </div>

          <!-- ПЛАВНО РАЗВЕРТЫВАЮЩИЙСЯ АККОРДЕОН ХАРАКТЕРИСТИК -->
          <div id="dynamic-attributes-wrapper" class="grid grid-rows-[0fr] opacity-0 transition-all duration-500 ease-in-out">
            <div class="overflow-hidden">
              <div class="space-y-4 pt-4 border-t border-zinc-100 dark:border-white/[0.06]">
                <span class="text-xs font-mono uppercase tracking-widest text-zinc-500 font-bold block">
                  Характеристики категории:
                </span>
                <div id="dynamic-attributes-list" class="space-y-4">
                  <!-- Заполняется JS -->
                </div>
              </div>
            </div>
          </div>

          <div class="pt-4 border-t border-zinc-100 dark:border-white/[0.06]">
            <button 
              type="button" 
              onclick="downloadFullCatalogPdf()" 
              class="w-full py-3 rounded-2xl bg-zinc-900 hover:bg-zinc-800 text-white dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200 text-xs font-mono font-bold transition flex items-center justify-center gap-2 shadow-sm"
            >
              <span>Скачать прайс-лист (PDF)</span>
            </button>
          </div>

        </div>

      </aside>

      <!-- ПРАВАЯ ЧАСТЬ: ПОИСК И ВИТРИНА -->
      <section class="lg:col-span-8 space-y-6">
        
        <div class="relative">
          <input 
            type="text" 
            id="catalog-search" 
            placeholder="Поиск по названию, размерам, свойствам..."
            class="w-full pl-5 pr-10 py-4 rounded-2xl bg-white dark:bg-[#181a1f] border border-zinc-200/80 dark:border-white/[0.08] text-sm text-zinc-900 dark:text-[#f0f2f5] placeholder-zinc-400 focus:outline-none focus:border-[#3dd68c] shadow-sm transition"
          />
          <button id="search-clear" class="absolute inset-y-0 right-0 pr-4 flex items-center text-zinc-400 hover:text-zinc-600 dark:hover:text-white hidden">
            ✕
          </button>
        </div>

        <div id="catalog-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {allVariantCards.map(item => {
            return (
              <div 
                class="catalog-item rounded-3xl bg-white dark:bg-[#181a1f] border border-zinc-200/80 dark:border-white/[0.08] p-5 flex flex-col justify-between hover:border-[#0d9488]/40 dark:hover:border-[#3dd68c]/40 hover:-translate-y-1.5 hover:shadow-xl transition-all duration-300 group"
                data-search={item.searchableText}
                data-categories={item.categoryIds.join(',')}
                data-attributes={JSON.stringify(item.attributes)}
              >
                <div class="space-y-3.5">
                  {item.parentProduct.coverImage && (
                    <a href={item.directUrl} class="block h-48 rounded-2xl overflow-hidden bg-zinc-100 dark:bg-black/40 relative">
                      <img src={item.parentProduct.coverImage} alt={item.fullTitle} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                      <span class="absolute top-3 right-3 text-[10px] font-mono font-bold text-[#0b633b] dark:text-[#3dd68c] px-2.5 py-1 rounded-full bg-white/90 dark:bg-[#181a1f]/90 backdrop-blur-md border border-[#3dd68c]/30">
                        В наличии
                      </span>
                    </a>
                  )}

                  <div>
                    <h3 class="text-base font-bold text-zinc-900 dark:text-[#f0f2f5] group-hover:text-[#0d9488] dark:group-hover:text-[#3dd68c] transition-colors leading-snug">
                      <a href={item.directUrl}>{item.fullTitle}</a>
                    </h3>
                  </div>

                  <div class="flex flex-wrap gap-1.5">
                    {Object.entries(item.variant.attributes).map(([key, val]) => (
                      <span class="text-xs font-mono px-2.5 py-0.5 rounded-lg bg-zinc-100 dark:bg-[#111215] border border-zinc-200 dark:border-white/[0.04] text-zinc-600 dark:text-zinc-400">
                        {key}: {val}
                      </span>
                    ))}
                  </div>
                </div>

                <div class="pt-4 mt-4 border-t border-zinc-200 dark:border-white/[0.06] flex items-center justify-between gap-2">
                  <div class="font-mono shrink-0">
                    {item.firstPrice ? (
                      <div>
                        <span class="text-[10px] text-zinc-500 block uppercase">/ {item.firstUnit}</span>
                        <span class="text-lg font-extrabold text-zinc-900 dark:text-[#f0f2f5]">{item.firstPrice} ₽</span>
                      </div>
                    ) : (
                      <span class="text-xs font-bold text-zinc-400">По согл.</span>
                    )}
                  </div>

                  <div class="flex items-center gap-1.5">
                    <div class="flex items-center bg-zinc-100 dark:bg-white/[0.06] border border-zinc-200 dark:border-white/[0.08] rounded-xl px-1.5 py-1">
                      <button type="button" class="btn-qty-minus text-zinc-400 hover:text-zinc-900 dark:hover:text-white px-1 font-bold text-xs">−</button>
                      <input 
                        type="number" 
                        value="1" 
                        min="1" 
                        max="999" 
                        class="item-qty-input w-6 text-center bg-transparent font-mono text-xs font-bold text-zinc-900 dark:text-white focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" 
                      />
                      <button type="button" class="btn-qty-plus text-zinc-400 hover:text-zinc-900 dark:hover:text-white px-1 font-bold text-xs">+</button>
                    </div>

                    <button 
                      type="button"
                      class="btn-add-card px-3 py-2 rounded-xl bg-[#3dd68c]/15 text-[#0b633b] dark:text-[#3dd68c] hover:bg-[#3dd68c] hover:text-[#111215] text-xs font-bold border border-[#3dd68c]/30 transition shrink-0"
                      data-id={item.id}
                      data-title={item.fullTitle}
                      data-price={item.firstPrice || 0}
                      data-unit={item.firstUnit}
                    >
                      + В заявку
                    </button>
                  </div>
                </div>

              </div>
            );
          })}
        </div>

        <div id="no-results" class="hidden text-center py-20 border border-dashed border-zinc-200 dark:border-white/[0.08] rounded-3xl p-8">
          <div class="text-base font-bold text-zinc-900 dark:text-[#f0f2f5]">Ничего не найдено</div>
          <p class="text-xs font-mono text-zinc-400 mt-1 max-w-sm mx-auto">
            Попробуйте сбросить фильтры или изменить запрос.
          </p>
        </div>

      </section>

    </div>

  </div>

  <script is:inline define:vars={{ rawVariantCards: allVariantCards }}>
    const searchInput = document.getElementById('catalog-search');
    const clearBtn = document.getElementById('search-clear');
    const catButtons = document.querySelectorAll('.cat-filter-btn');
    const dynamicWrapper = document.getElementById('dynamic-attributes-wrapper');
    const dynamicList = document.getElementById('dynamic-attributes-list');
    const resetBtn = document.getElementById('reset-all-filters');
    const items = document.querySelectorAll('.catalog-item');
    const counterEl = document.getElementById('catalog-counter');
    const noResultsEl = document.getElementById('no-results');

    const urlParams = new URLSearchParams(window.location.search);
    const searchParam = urlParams.get('search');
    if (searchParam && searchInput) {
      searchInput.value = searchParam;
    }

    let activeCategory = 'all';
    let searchQuery = (searchInput ? searchInput.value : '').trim().toLowerCase();

    function renderDynamicFilters(categoryId) {
      if (!dynamicWrapper || !dynamicList) return;

      if (categoryId === 'all') {
        dynamicWrapper.classList.remove('grid-rows-[1fr]', 'opacity-100');
        dynamicWrapper.classList.add('grid-rows-[0fr]', 'opacity-0');
        setTimeout(() => { dynamicList.innerHTML = ''; }, 400);
        return;
      }

      const catItems = rawVariantCards.filter(item => item.categoryIds.includes(categoryId));
      const attrMap = {};

      catItems.forEach(item => {
        Object.entries(item.attributes).forEach(([k, v]) => {
          if (!attrMap[k]) attrMap[k] = new Set();
          attrMap[k].add(String(v));
        });
      });

      if (Object.keys(attrMap).length === 0) {
        dynamicWrapper.classList.remove('grid-rows-[1fr]', 'opacity-100');
        dynamicWrapper.classList.add('grid-rows-[0fr]', 'opacity-0');
        setTimeout(() => { dynamicList.innerHTML = ''; }, 400);
        return;
      }

      // Генерация стилизованных Bento-чипов с интерактивным выбором
      dynamicList.innerHTML = Object.entries(attrMap).map(([attrKey, valSet]) => `
        <div class="space-y-2">
          <span class="text-xs font-mono font-bold text-zinc-700 dark:text-zinc-300 block">${attrKey}:</span>
          <div class="flex flex-col gap-1.5">
            ${Array.from(valSet).map(val => `
              <label class="group relative flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-mono cursor-pointer transition-all duration-200 bg-zinc-50 dark:bg-[#111215] border border-zinc-200/80 dark:border-white/[0.04] hover:border-zinc-300 dark:hover:border-white/[0.2] has-[:checked]:bg-[#3dd68c]/15 has-[:checked]:border-[#3dd68c] has-[:checked]:text-[#0b633b] dark:has-[:checked]:text-[#3dd68c] has-[:checked]:font-bold text-zinc-700 dark:text-zinc-300">
                <input type="checkbox" class="dynamic-attr-cb sr-only" data-key="${attrKey}" data-val="${val}" />
                <span class="truncate pr-2">${val}</span>
                <span class="w-4 h-4 rounded-md border border-zinc-300 dark:border-zinc-700 group-has-[:checked]:border-[#3dd68c] group-has-[:checked]:bg-[#3dd68c] flex items-center justify-center transition-colors shrink-0">
                  <svg class="w-2.5 h-2.5 text-zinc-950 opacity-0 group-has-[:checked]:opacity-100 transition-opacity" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
              </label>
            `).join('')}
          </div>
        </div>
      `).join('');

      // Плавное раскрытие аккордеона
      dynamicWrapper.classList.remove('grid-rows-[0fr]', 'opacity-0');
      dynamicWrapper.classList.add('grid-rows-[1fr]', 'opacity-100');

      document.querySelectorAll('.dynamic-attr-cb').forEach(cb => {
        cb.addEventListener('change', applyFilters);
      });
    }

    function applyFilters() {
      let visibleCount = 0;

      const selectedAttrs = {};
      document.querySelectorAll('.dynamic-attr-cb:checked').forEach(cb => {
        const k = cb.getAttribute('data-key');
        const v = cb.getAttribute('data-val');
        if (!selectedAttrs[k]) selectedAttrs[k] = [];
        selectedAttrs[k].push(v);
      });

      items.forEach(item => {
        const itemCategories = (item.getAttribute('data-categories') || '').split(',');
        const itemText = item.getAttribute('data-search') || '';
        const itemAttrs = JSON.parse(item.getAttribute('data-attributes') || '{}');

        const matchesCat = activeCategory === 'all' || itemCategories.includes(activeCategory);
        const matchesSearch = !searchQuery || itemText.includes(searchQuery);

        let matchesAttrs = true;
        for (const [key, vals] of Object.entries(selectedAttrs)) {
          if (!itemAttrs[key] || !vals.includes(String(itemAttrs[key]))) {
            matchesAttrs = false;
            break;
          }
        }

        if (matchesCat && matchesSearch && matchesAttrs) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (counterEl) counterEl.textContent = `Показано: ${visibleCount} позиций`;
      if (noResultsEl) noResultsEl.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        if (clearBtn) clearBtn.style.display = searchQuery ? 'flex' : 'none';
        applyFilters();
      });
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        searchQuery = '';
        clearBtn.style.display = 'none';
        applyFilters();
      });
    }

    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        catButtons.forEach(b => {
          b.className = 'cat-filter-btn w-full p-3.5 rounded-2xl text-left text-sm font-semibold transition-all flex items-center justify-between bg-zinc-50 dark:bg-[#111215] text-zinc-700 dark:text-zinc-300 border border-zinc-200/80 dark:border-white/[0.04] hover:border-zinc-300 dark:hover:border-white/[0.2]';
        });
        btn.className = 'cat-filter-btn active w-full p-3.5 rounded-2xl text-left text-sm font-semibold transition-all flex items-center justify-between bg-[#3dd68c]/15 text-[#0b633b] dark:text-[#3dd68c] border border-[#3dd68c]';
        
        activeCategory = btn.getAttribute('data-category') || 'all';
        renderDynamicFilters(activeCategory);
        applyFilters();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        searchQuery = '';
        activeCategory = 'all';
        catButtons.forEach(b => {
          b.className = b.getAttribute('data-category') === 'all'
            ? 'cat-filter-btn active w-full p-3.5 rounded-2xl text-left text-sm font-semibold transition-all flex items-center justify-between bg-[#3dd68c]/15 text-[#0b633b] dark:text-[#3dd68c] border border-[#3dd68c]'
            : 'cat-filter-btn w-full p-3.5 rounded-2xl text-left text-sm font-semibold transition-all flex items-center justify-between bg-zinc-50 dark:bg-[#111215] text-zinc-700 dark:text-zinc-300 border border-zinc-200/80 dark:border-white/[0.04] hover:border-zinc-300 dark:hover:border-white/[0.2]';
        });
        renderDynamicFilters('all');
        if (clearBtn) clearBtn.style.display = 'none';
        applyFilters();
      });
    }

    document.querySelectorAll('.catalog-item').forEach(card => {
      const minusBtn = card.querySelector('.btn-qty-minus');
      const plusBtn = card.querySelector('.btn-qty-plus');
      const input = card.querySelector('.item-qty-input');
      const addBtn = card.querySelector('.btn-add-card');

      if (minusBtn && input) {
        minusBtn.addEventListener('click', () => {
          let v = parseInt(input.value || '1', 10);
          if (v > 1) input.value = v - 1;
        });
      }

      if (plusBtn && input) {
        plusBtn.addEventListener('click', () => {
          let v = parseInt(input.value || '1', 10);
          input.value = v + 1;
        });
      }

      if (addBtn && input) {
        addBtn.addEventListener('click', () => {
          const qty = parseInt(input.value || '1', 10);
          window.addToOrderSheetWithQty({
            id: addBtn.getAttribute('data-id'),
            title: addBtn.getAttribute('data-title'),
            price: parseFloat(addBtn.getAttribute('data-price') || '0'),
            unit: addBtn.getAttribute('data-unit')
          }, qty);
        });
      }
    });

    applyFilters();
  </script>
</Layout>